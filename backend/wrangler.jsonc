{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dopaccess",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "kv_namespaces": [
    // `npx wrangler kv namespace create DOPA_KV` で作った id に差し替える
    { "binding": "DOPA_KV", "id": "REPLACE_WITH_YOUR_KV_ID" }
  ],
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],
  // 毎時起動し、プロパティのタイムゾーンで 03:00 のときだけベースラインを再計算する
  "triggers": { "crons": ["5 * * * *"] },
  "vars": {
    "GA4_PROPERTY_IDS": "",
    "MIN_BASELINE": "5",
    "MIN_BURST_USERS": "10",
    "TIER_SET": "mvp",
    "TIER_THRESHOLDS": "",
    "CACHE_TTL_SEC": "60",
    "REALTIME_TO_HOURLY_K": "1.0"
  }
  // secrets: API_SECRET, GOOGLE_SA_CLIENT_EMAIL, GOOGLE_SA_PRIVATE_KEY（`wrangler secret put` で登録）
}
